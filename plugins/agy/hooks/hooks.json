{
  "description": "Tracks the Claude Code session for agy jobs and stops a session's running jobs when it ends.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/agy_companion.py\" session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/agy_companion.py\" session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
